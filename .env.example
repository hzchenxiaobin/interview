DATABASE_URL=mysql://root:root@localhost:3306/interview
PORT=3001
# LLM（可选，不配置则自动使用规则引擎）
# Moonshot 开放平台：https://api.moonshot.cn/v1 + moonshot-v1-8k
# Kimi Code 会员 Key（sk-kimi 开头）：https://api.kimi.com/coding/v1 + kimi-for-coding / k3-256k
# CANNBot 网关（华为内部）：https://cannbot.hicann.cn/gateway/compatible-mode/v1 + glm-5.2
#   需双头认证：LLM_API_KEY 填 CLI 登录后的 access JWT（~/.local/share/opencode/auth.json 的 cannbot-cli.access），
#   LLM_VKEY 填 vk- 开头的 virtual key
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=
LLM_MODEL=moonshot-v1-8k
LLM_VKEY=
